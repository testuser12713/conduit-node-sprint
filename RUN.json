{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "node",
      "kind": "server",
      "install": [["npm", "install", "--include=dev", "--no-audit", "--no-fund"]],
      "build": [["npm", "run", "build"]],
      "test": [["npm", "test"]],
      "start": ["node", "node_modules/ts-node/dist/bin.js", "--transpile-only", "--compiler-options", "{\"module\":\"CommonJS\"}", "src/main.ts"],
      "port": 3000,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "JWT_SECRET": { "generate": "hex", "bytes": 32 }
      },
      "depends_on": ["db"]
    },
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    }
  ]
}
