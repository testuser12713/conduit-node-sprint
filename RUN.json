{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "api",
      "dir": ".",
      "stack": "node",
      "kind": "server",
      "install": [["npm", "install"], ["npx", "prisma", "generate"]],
      "build": [["npx", "nx", "build", "api"]],
      "start": ["npx", "nx", "serve", "api", "--watch=false"],
      "port": 3000,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "ready_timeout_s": 60,
      "test": [["npm", "test"]],
      "seed": [["npx", "prisma", "db", "seed"]],
      "depends_on": ["db"],
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "JWT_SECRET": { "generate": "hex", "bytes": 32 },
        "NODE_ENV": { "dev": "development" }
      }
    }
  ]
}
