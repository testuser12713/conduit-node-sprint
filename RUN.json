{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "node",
      "kind": "server",
      "install": [["npm", "install", "--no-audit", "--no-fund"]],
      "build": [["npm", "run", "build"]],
      "start": ["node", "dist/api/main.js"],
      "port": 3000,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [200]
      },
      "test": [["npm", "test"]],
      "env": {
        "DATABASE_URL": { "dev": "${service:db.url}" },
        "JWT_SECRET": { "generate": "hex", "bytes": 32 },
        "NODE_ENV": { "dev": "development" }
      }
    },
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    }
  ]
}
