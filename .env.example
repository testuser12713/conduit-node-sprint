# Copy this file to .env for local development.
# The office's runner supplies DATABASE_URL and a random JWT_SECRET on every run.

# PostgreSQL connection read by Prisma. Point this at your local PostgreSQL instance.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DATABASE

# Generate a value before starting locally, for example:
#   openssl rand -hex 32
JWT_SECRET=

# Port the Express server binds to.
PORT=3000

NODE_ENV=development
