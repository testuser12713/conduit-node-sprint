# Copy this file to .env and adjust the values for your machine.
# Start the PostgreSQL database first with: docker compose up -d db
DATABASE_URL=postgresql://app@localhost:5432/app

# Signing key for the JWTs issued by the API.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

NODE_ENV=development
