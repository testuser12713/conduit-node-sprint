# Copy this file to .env and fill in the values before running the API locally.
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://app@localhost:5432/app
# Signing secret for JWTs. Generate a random hex value, e.g. `openssl rand -hex 32`.
JWT_SECRET=
# Runtime mode. Use `production` outside local development.
NODE_ENV=production
# Port the API listens on.
PORT=3000
